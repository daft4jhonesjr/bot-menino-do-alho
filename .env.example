# ============================================================
# CONFIGURAÇÕES DO BOT (bot-boletos)
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# O .env NÃO deve ser commitado no git (já está no .gitignore).

# URL base do servidor Flask no Render
# Produção:
API_URL=https://sistema-menino-do-alho.onrender.com
# Desenvolvimento local (descomente para testar localmente):
# API_URL=http://localhost:5000

# Token de autenticação para a rota /api/bot/upload
# DEVE ser idêntico à variável API_BOT_TOKEN configurada no Render Dashboard.
API_BOT_TOKEN=ALHO_BOT_SUPER_SECRETO_2026_XYZ

# Empresa dona dos documentos enviados pelo bot.
# Enviada explicitamente no FormData para não depender só do fallback do Render.
EMPRESA_ID=1

# Porta do servidor HTTP local do bot (Render usa process.env.PORT automaticamente)
# PORT=8080

# Diretório de dados (Render: aponte para o disco persistente /data se configurado)
# DATA_DIR=/data
